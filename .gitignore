# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# 运行时数据（数据库、上传文件、备份、日志、密钥、初始口令）
# 这些内容因人而异，且可能含隐私信息，绝不入库
data/
data_cpp/
*.db
*.db-wal
*.db-shm
*.sql
初始管理员密码.txt
config.json

# 证书与私钥：每个人用自己的域名/证书，绝不共用
cert/
*.pem
*.key
*.pfx
*.crt
*.csr

# 构建产物
build/
dist/
*.egg-info/
__pycache__/

# 随包二进制依赖
# —— MySQL 免安装版共 864 MB，单个 mysqld.pdb 就 332 MB，
#    既超过 GitHub 单文件 100 MB 上限，也会让 clone 变得极其缓慢。
#    使用者按 docs/部署指南.md 用 tools/setup_mysql.py 自行准备。
vendor/mysql/
# —— pymysql 是纯 Python 驱动（约 100 KB），随仓库分发，
#    这样克隆后切到 MySQL 模式即可直接用，无需 pip install。
#    （vendor/pymysql/ 与 vendor/pymysql-*.dist-info/ 均已入库）

# 下载/临时目录
_dl/
_tmp/
_diag_*/
_fresh_*/

# 测试与调试残留
_srv*.log
_read_verify.png
_diag_pwd.py
*.log

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
